#include <stdio.h>

int main() {
    int mat[3][3];
    int i, j;
    int soma = 0;

    printf("Digite os valores da matriz 3x3:\n");
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("Posicao [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
            soma = soma + mat[i][j];
        }
    }

    printf("\nA soma de todos os elementos da matriz é: %d\n", soma);

    return 0;
}

O programa lê os números inseridos para preencher uma matriz 3x3. Durante a leitura de cada posição, ele vai somando o valor recebido dentro da variável soma e, no fim, exibe o total acumulado.
