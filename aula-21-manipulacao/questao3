#include <stdio.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main(void) {
    Funcionario f;
    FILE *arquivo;
    int opcao, quantidade, i;

    do {
        printf("\n=== CADASTRO DE FUNCIONARIOS ===\n");
        printf("1 - Cadastrar funcionarios\n");
        printf("2 - Ver funcionarios cadastrados\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
            scanf("%d", &quantidade);

            if (quantidade < 1 || quantidade > 5) {
                printf("Quantidade invalida!\n");
                continue;
            }

            arquivo = fopen("funcionarios.txt", "a");

            if (arquivo == NULL) {
                printf("Erro ao abrir o arquivo.\n");
                continue;
            }

            for (i = 0; i < quantidade; i++) {
                printf("\nFuncionario %d\n", i + 1);

                printf("Nome: ");
                scanf(" %49[^\n]", f.nome);

                printf("Salario (use ponto para decimais): ");
                scanf("%f", &f.salario);

                printf("Horas extras: ");
                scanf("%d", &f.horasExtras);

                fprintf(arquivo, "%s\n", f.nome);
                fprintf(arquivo, "%.2f %d\n", f.salario, f.horasExtras);
            }

            fclose(arquivo);
            printf("\nFuncionarios cadastrados com sucesso!\n");
        } else if (opcao == 2) {
            arquivo = fopen("funcionarios.txt", "r");

            if (arquivo == NULL) {
                printf("Ainda nao ha funcionarios cadastrados.\n");
                continue;
            }

            printf("\n=== FUNCIONARIOS CADASTRADOS ===\n");

            while (fscanf(arquivo, " %49[^\n]", f.nome) == 1) {
                if (fscanf(arquivo, "%f %d", &f.salario, &f.horasExtras) != 2) {
                    break;
                }

                printf("\nNome: %s\n", f.nome);
                printf("Salario: R$ %.2f\n", f.salario);
                printf("Horas extras: %d\n", f.horasExtras);
            }

            fclose(arquivo);
        } else if (opcao == 0) {
            printf("Programa encerrado.\n");
        } else {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    return 0;
}
