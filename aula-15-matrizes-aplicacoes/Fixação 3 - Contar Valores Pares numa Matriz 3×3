#include <stdio.h>

int main() {
    int mat[3][3];
    int i, j;
    int pares = 0;

    printf("Digite os valores da matriz 3x3:\n");
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("Posicao [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);

            if (mat[i][j] % 2 == 0) {
                pares++;
            }
        }
    }

    printf("\nQuantidade de numeros pares: %d\n", pares);

    return 0;
}

Explicação: Este programa lê os valores informados para preencher uma matriz 3x3. Durante a leitura, ele usa o operador resto de divisão (% 2 == 0) para verificar se o número digitado é par e incrementa um contador sempre que encontra um valor par.
