#include <stdio.h>

int main() {
    // Matriz 3x4 baseada no mapa do cinema
    // 0 = livre, 1 = ocupado
    int assentos[3][4] = {
        {0, 1, 0, 0},
        {1, 1, 0, 1},
        {0, 0, 1, 0}
    };

    int i, j;
    int ocupados = 0;
    int livres = 0;

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 4; j++) {
            if (assentos[i][j] == 1) {
                ocupados++;
            } else {
                livres++;
            }
        }
    }

    printf("Assentos ocupados: %d\n", ocupados);
    printf("Assentos disponiveis: %d\n", livres);

    return 0;
}
