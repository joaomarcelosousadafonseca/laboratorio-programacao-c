#include <stdio.h>
#include <string.h>

int main() {
    char nome[50];
    char perfil_input[20];
    char perfil_extenso[30];
    char nome_confirmacao[50];
    char mensagem[100] = "Bem-vindo(a), ";
    int tamanho_nome;

    printf("===== CADASTRO DE USUARIOS =====\n\n");
    printf("Digite seu nome: ");
    scanf("%s", nome);
    printf("Digite seu perfil: ");
    scanf("%s", perfil_input);

    // 3. Tamanho do nome com strlen()
    tamanho_nome = strlen(nome);

    // 4. Identificacao do perfil com strcmp()
    if (strcmp(perfil_input, "ADMIN") == 0) {
        strcpy(perfil_extenso, "Administrador");
    } else {
        strcpy(perfil_extenso, "Comum");
    }

    // 5. Copia o nome para a variavel de confirmacao com strcpy()
    strcpy(nome_confirmacao, nome);

    // 6. Monta a mensagem de boas-vindas com strcat()
    strcat(mensagem, nome_confirmacao);
    strcat(mensagem, "!");

    // 7. Exibicao dos dados e resultado final
    printf("\n===== DADOS CADASTRADOS =====\n");
    printf("Nome: %s\n", nome_confirmacao);
    printf("Quantidade de caracteres: %d\n", tamanho_nome);
    printf("Perfil: %s\n\n", perfil_extenso);
    printf("%s\n", mensagem);
    printf("Cadastro realizado com sucesso.\n");

    return 0;
}

O programa lê o nome e o perfil do usuário (ADMIN ou COMUM). Utiliza strlen() para contar as letras do nome, strcmp() para verificar se o perfil é ADMIN, strcpy() para copiar o nome para uma variável de confirmação e strcat() para concatenar "Bem-vindo(a), " com o nome copiado para montar a mensagem de recepção.
