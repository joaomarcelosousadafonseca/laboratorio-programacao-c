#include <stdio.h>

int main() {
    int mat[3][3];
    int i, j;
    int maior;

    printf("Digite os valores da matriz 3x3:\n");
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            printf("Posicao [%d][%d]: ", i, j);
            scanf("%d", &mat[i][j]);
        }
    }

    maior = mat[0][0];

    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            if (mat[i][j] > maior) {
                maior = mat[i][j];
            }
        }
    }

    printf("\nO maior valor encontrado foi: %d\n", maior);

    return 0;
}

O código lê uma matriz 3x3, assume inicialmente que o primeiro elemento mat[0][0] é o maior e depois percorre toda a matriz comparando os elementos para encontrar e exibir o maior número.
