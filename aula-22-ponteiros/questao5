#include <stdio.h>

int main(void) {
    int numeros[5];
    int *ponteiro = numeros;
    int i;

    for (i = 0; i < 5; i++) {
        printf("Digite o %d numero: ", i + 1);
        scanf("%d", &numeros[i]);
    }

    printf("\nNumeros do vetor:\n");

    for (i = 0; i < 5; i++) {
        printf("%d\n", *(ponteiro + i));
    }

    return 0;
}
